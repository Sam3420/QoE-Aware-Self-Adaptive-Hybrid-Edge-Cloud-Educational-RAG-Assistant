# Copy to .env and fill in. Never commit .env.
HF_TOKEN=
YOUTUBE_API_KEY=

# Optional overrides (defaults in config.py)
# YOUTUBE_REGION_CODE=IN
# TRANSCRIPTS_ENABLED=true
# TRANSCRIPT_LANGUAGES=["en","hi"]
# TRANSCRIPT_CACHE_TTL_S=86400
# REC_WEIGHTS={"topic_similarity":0.25,"transcript_relevance":0.30,"difficulty_match":0.10,"language_match":0.10,"duration_match":0.08,"caption_match":0.05,"historical_outcome":0.07,"popularity":0.05}
# Adaptive policy / metrics (defaults in config.py; see docs/adaptive_policy.md)
# METRIC_WEIGHTS_SOURCE=fixed
# METRIC_MISSING_POLICY=renormalize
# METRIC_WEIGHTS={"qoe":{"EQ":0.35,"AQ":0.25,"NQ":0.20,"UX":0.20},"eq":{"LG":0.35,"PT":0.30,"RA":0.15,"LS":0.20},"aq":{"RQ":0.40,"LQ":0.30,"SQ":0.15,"TQ":0.15},"nq":{"PL":0.35,"NR":0.25,"RU":0.15,"AV":0.25},"ux":{"SR":0.45,"FS":0.20,"CR":0.35},"sre":{"CPU":0.35,"MEM":0.30,"EN":0.20,"NE":0.15},"utility":{"QOE":0.7,"SRE":0.3},"reward":{"QOE":0.7,"SRE":0.3}}
# POLICY_RNG_SEED=42
# Langfuse tracing (docs/observability.md). Tracing is off until both keys are set.
# Create the key pair in your Langfuse project under Settings > API Keys. Never commit real keys.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://localhost:3000
# LANGFUSE_ENVIRONMENT=development
# LANGFUSE_RELEASE=
# LANGFUSE_SAMPLE_RATE=1.0
# LANGFUSE_CAPTURE_CONTENT=true   # false: learner text/answers are not sent (structure, models, usage, scores still are)
