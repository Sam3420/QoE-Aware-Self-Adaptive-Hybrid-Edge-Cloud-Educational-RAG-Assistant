APP_NAME="QoE Educational Assistant"
APP_ENV="local"
LOG_LEVEL="INFO"

# Local edge deployment defaults. Use relative paths for portable deployments.
DATA_ROOT="data"
DATABASE_PATH="data/app.db"
KNOWLEDGE_STORAGE_PATH="data/knowledge"
VECTOR_INDEX_STORAGE_PATH="data/vector_indexes"
METRICS_STORAGE_PATH="data/metrics"
EXPERIENCE_STORAGE_PATH="data/experiences"

# DATABASE_URL can override DATABASE_PATH when needed.
# DATABASE_URL="sqlite:///data/app.db"
